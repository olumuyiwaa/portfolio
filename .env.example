# Canonical public URL of this portfolio (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact details shown on the site and used by the contact form.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/olumuyiwaa
NEXT_PUBLIC_LINKEDIN_URL=

# Contact form delivery (optional). Get a key at resend.com. Without it the
# form falls back to opening the visitor's mail app.
RESEND_API_KEY=
# Where enquiries are sent (defaults to NEXT_PUBLIC_CONTACT_EMAIL).
CONTACT_TO_EMAIL=
# Sender. Use a verified domain in production; the default works for testing.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
